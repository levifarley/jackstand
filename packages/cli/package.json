  "keywords": [
    "characterization-tests",
    "legacy-code",
    "php",
    "testing",
    "test-generation",
    "llm",
    "golden-master",
    "mutation-testing"
  ],
  "homepage": "https://github.com/levifarley/jackstand#readme",
