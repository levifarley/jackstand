  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levifarley/jackstand.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Levi Farley",
  "type": "module",
  "bin": {
    "jackstand": "dist/bin.js"
  },
  "files": [
